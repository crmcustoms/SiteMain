{
  "name": "Booking - Create Appointment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-create",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "booking-create"
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "={{ $json.body.calendarId }}",
          "mode": "id"
        },
        "start": "={{ $json.body.startDateTime }}",
        "end": "={{ $json.body.endDateTime }}",
        "title": "Консультація: {{ $json.body.clientName }}",
        "description": "Клієнт: {{ $json.body.clientName }}\nEmail: {{ $json.body.clientEmail }}\nТелефон: {{ $json.body.clientPhone }}\n\nКоментар: {{ $json.body.notes || 'Немає' }}",
        "sendUpdates": "none",
        "options": {
          "conferenceDataVersion": 1
        }
      },
      "id": "google-calendar-create",
      "name": "Google Calendar - Create Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CREDENTIALS_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('Webhook Trigger').item.json.body.planfixAccount }}.planfix.ru/rest/task/",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Webhook Trigger').item.json.body.planfixToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"Консультація: {{ $('Webhook Trigger').item.json.body.clientName }}\",\n  \"description\": \"Бронювання консультації\\n\\nКлієнт: {{ $('Webhook Trigger').item.json.body.clientName }}\\nEmail: {{ $('Webhook Trigger').item.json.body.clientEmail }}\\nТелефон: {{ $('Webhook Trigger').item.json.body.clientPhone }}\\n\\nДата та час: {{ $('Webhook Trigger').item.json.body.startDateTime }}\\n\\nКоментар: {{ $('Webhook Trigger').item.json.body.notes || 'Немає' }}\\n\\nGoogle Calendar Event ID: {{ $json.id }}\",\n  \"project\": {{ $('Webhook Trigger').item.json.body.planfixProjectId }}\n}",
        "options": {}
      },
      "id": "planfix-create-task",
      "name": "Planfix - Create Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"success\": true,\n  \"eventId\": $('Google Calendar - Create Event').item.json.id,\n  \"planfixTaskId\": $('Planfix - Create Task').item.json.id,\n  \"message\": \"Бронювання успішно створено\"\n} }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
